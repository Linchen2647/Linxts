# Linxts never downloads models automatically. Start llama-server separately.
# CLI endpoints must be loopback HTTP URLs.
LINXTS_LLAMA_3B_URL=http://127.0.0.1:8080
LINXTS_LLAMA_3B_MODEL=local-3b

# Optional escalation tiers:
# LINXTS_LLAMA_7B_URL=http://127.0.0.1:8081
# LINXTS_LLAMA_7B_MODEL=local-7b
# LINXTS_LLAMA_LARGE_URL=http://127.0.0.1:8082
# LINXTS_LLAMA_LARGE_MODEL=local-larger

# Bounded runtime controls:
LINXTS_AI_TIMEOUT_SECS=30
LINXTS_AI_RETRIES=1

# No online provider is implemented. Never put API keys in this file.
